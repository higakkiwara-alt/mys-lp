     "end": 518.407
    }
   ]
  },
  {
   "no": 17,
   "start": 519.557,
   "duration": 29.666,
   "cues": [
    {
     "text": "独立しても、結婚しても、会社にいても。",
     "start": 520.257,
     "end": 523.987
    },
    {
     "text": "どの道にも、絶対の安定はありませんでした。",
