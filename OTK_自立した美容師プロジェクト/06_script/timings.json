  {
   "no": 14,
   "start": 405.393,
   "duration": 46.087,
   "cues": [
    {
     "text": "独立を考えている人も、いると思います。",
     "start": 406.093,
     "end": 409.384
    },
    {
     "text": "僕は、独立を否定しません。",
