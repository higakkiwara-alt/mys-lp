# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ai_salon_os"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI APIs
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."

# Google APIs
GOOGLE_CLIENT_ID="your-client-id"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REFRESH_TOKEN="your-refresh-token"
GOOGLE_BUSINESS_ACCOUNT_ID="accounts/your-account-id"
GOOGLE_BUSINESS_LOCATION_ID="locations/your-location-id"
GOOGLE_MAPS_API_KEY="your-maps-api-key"

# Instagram / Meta
INSTAGRAM_ACCESS_TOKEN="your-instagram-access-token"
INSTAGRAM_BUSINESS_ACCOUNT_ID="your-account-id"
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"

# LINE
LINE_CHANNEL_ACCESS_TOKEN="your-line-channel-access-token"
LINE_CHANNEL_SECRET="your-line-channel-secret"

# WordPress
WORDPRESS_URL="https://your-salon.com"
WORDPRESS_USERNAME="your-username"
WORDPRESS_APP_PASSWORD="your-app-password"

# AI Router OS (docs/ai-router-os/ 参照)
ROUTER_WEBHOOK_SECRET="shared-secret-with-n8n"        # n8n/LINE/音声からの intake 認証
N8N_REPORT_WEBHOOK_URL="https://xxx.app.n8n.cloud/webhook/router-report"  # 完了報告→LINE通知
N8N_PUBLISH_WEBHOOK_URL="https://xxx.app.n8n.cloud/webhook/router-publish" # 承認後のSNS投稿（未設定なら下書き保存まで）
OBSIDIAN_VAULT_REPO="owner/companyos-vault"           # Obsidian Vault (GitHub, Git同期済み)
OBSIDIAN_VAULT_TOKEN="github_pat_..."                 # contents: read/write
OBSIDIAN_VAULT_BRANCH="main"

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="your-cron-secret-for-github-actions"
